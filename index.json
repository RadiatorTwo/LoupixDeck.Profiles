    {
      "id": "calculator-lin",
      "name": "Calculator",
      "description": "Speed-up your math by quick-launching the calculator app and use the HW buttons of your device instead of mouse and keyboard. Press the calculator symbol to launch your calculator. It works with GNOME, KDE, Xfce, Cinnamon and minimal. For Wayland and X11.",
      "author": "Rand0mB0y",
      "version": "1.0.1",
      "updatedAt": "2026-11-16T13:09:38Z",
      "license": "CC-BY-4.0",
      "tags": [
        "calculator",
        "math",
        "calc",
        "cinnamon",
        "gnome",
        "kde",
        "xfce",
        "minimal"
      ],
      "platforms": [
        "Linux"
      ],
      "kind": "Workspace",
      "device": {
        "slug": "loupedeck-live",
        "name": "Loupedeck Live",
        "touchButtons": 14,
        "rotaryButtons": 6,
        "hasSideStrips": true
      },
      "requiredPlugins": [],
      "commands": [
        "System.KeyCombination",
        "sh -c 'for c in gnome-calculator kcalc xfce4-calculator xcalc; do if command -v $c >/dev/null; then case $c in gnome-calculator) t=gnome-calculato; w=Calculator;; xfce4-calculator) t=xfce4-calculato; w=Calculator;; kcalc) t=kcalc; w=KCalc;; *) t=$c; w=xcalc;; esac; if pgrep -x $t >/dev/null; then if [ $c = gnome-calculator ]; then busctl --user call org.gnome.Shell /de/lucaswerkmeister/ActivateWindowByTitle de.lucaswerkmeister.ActivateWindowByTitle activateBySubstring s Calculator 2>/dev/null; if [ $? -eq 0 ]; then exit 0; fi; fi; if command -v wmctrl >/dev/null; then wmctrl -a $w 2>/dev/null; if [ $? -eq 0 ]; then exit 0; fi; fi; exec $c; else exec $c; fi; fi; done'"
      ],
      "macros": [],
      "formatVersion": 1,
      "configSchemaVersion": 13,
      "appVersion": "1.59.0",
      "preview": "https://raw.githubusercontent.com/RadiatorTwo/LoupixDeck.Profiles/master/profiles/Rand0mB0y/calculator-lin/preview.png",
      "screenshots": [
        "https://raw.githubusercontent.com/RadiatorTwo/LoupixDeck.Profiles/master/profiles/Rand0mB0y/calculator-lin/screenshots/device-page-1.png"
